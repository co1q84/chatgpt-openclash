mode: rule
log-level: info

# ==============================
# DNS：fake-ip + 国内 DoH + fallback 防泄漏
# ==============================
dns:
  enable: true
  ipv6: false

  # 国内域名返回真实 IP，其他域名继续使用 Fake-IP
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16

  fake-ip-filter:
    # 国内域名统一返回真实 IP
    - 'geosite:cn'

    # 局域网与本地服务
    - '*.lan'
    - '*.local'
    - 'localhost'
    - '+.home.arpa'
    - '+.in-addr.arpa'
    - '+.ip6.arpa'

    # 自家域名
    - '+.msgbox.top'

    # 网络连通性检测
    - 'localhost.ptlogin2.qq.com'
    - '+.msftconnecttest.com'
    - '+.msftncsi.com'

    # 路由器与智能家居
    - 'router.asus.com'
    - 'miwifi.com'
    - '+.market.xiaomi.com'
    - 'Mijia Cloud'

    # 时间同步
    - '+.pool.ntp.org'
    - 'time.*.com'
    - 'time.*.gov'
    - 'time.*.edu.cn'
    - 'time1.cloud.tencent.com'
    - 'time.ustc.edu.cn'
    - 'ntp.*.com'
    - 'ntp.*.cn'

    # STUN / WebRTC / 实时通信
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'

  # 用于解析 DoH 服务器自身域名
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29

  # 默认 DNS
  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query

  # 按域名类型指定 DNS
  nameserver-policy:
    # 国内域名交给国内 DNS，并配合 fake-ip-filter 返回真实 IP
    'geosite:cn':
      - https://doh.pub/dns-query
      - https://dns.alidns.com/dns-query

    # 局域网和反向解析交给系统 DNS
    '+.lan': system
    '+.local': system
    '+.home.arpa': system
    '+.in-addr.arpa': system
    '+.ip6.arpa': system
    '+.msgbox.top': system

    # 保留你的自有域名策略
    '+.pingbox.top': https://doh.pub/dns-query

# ==============================
# 节点与订阅
# ==============================
proxy-providers:
  XXJichang:
    # 使用你确认在 Clash 中可用的原始 HTTPS 测试链接
    url: http://sub.store/download/coco
    interval: 3600

    headers:
      User-Agent: "clash.meta"
      Accept: "application/yaml"

proxies:

  # FALL_BOX 通过 BEST_JC 机场策略组连接自建节点
  - name: FALL_BOX
    type: ss
    server: box.pingbox.top
    port: 28388
    cipher: 2022-blake3-aes-256-gcm
    password: nLBfo/TOofzezwRzjCowsNViRSxdz5qET9MCgpv3wWE=
    udp: true
    dialer-proxy: BEST_JC

  - name: BOX_VISION
    type: vless
    server: box.pingbox.top
    port: 9443
    uuid: 7c2fea8b-4231-4f1a-bd37-6add6bbb58dc
    network: tcp
    tls: true
    udp: true
    tfo: true
    flow: xtls-rprx-vision
    servername: www.apple.com
    client-fingerprint: chrome
    reality-opts:
      public-key: OeOZkKbtmWshlupDkgDeIN9juGV_2vBGxeyuLs0gd2o
      short-id: 1223456789abcdef

# ==============================
# 策略组：
# ==============================
proxy-groups:
  - name: BEST_JC
    type: url-test
    use:
      - XXJichang
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50

  - name: BOX_FIRST
    type: fallback
    proxies:
      - BOX_VISION
      - FALL_BOX
    url: https://www.gstatic.com/generate_204
    interval: 300

  - name: PROXY
    type: select
    proxies:
      - BOX_FIRST
      - FALL_BOX
      - BEST_JC

# ==============================
# 规则集
# ==============================
rule-providers:
  private:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/private.txt"
    interval: 86400

  lancidr:
    type: http
    behavior: ipcidr
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/lancidr.txt"
    interval: 86400

  ai:
    type: http
    behavior: domain
    url: "https://raw.githubusercontent.com/co1q84/chatgpt-openclash/main/ai.txt"
    interval: 86400

  proxy:
    type: http
    behavior: classical
    url: "https://raw.githubusercontent.com/co1q84/chatgpt-openclash/main/proxy.txt"
    interval: 86400

  direct:
    type: http
    behavior: classical
    url: "https://raw.githubusercontent.com/co1q84/chatgpt-openclash/main/direct.txt"
    interval: 86400

  # 替代原 GEOSITE,cn（Loyalsoldier direct.txt 即 geosite:cn 加速域名列表）
  cn-domain:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt"
    interval: 86400

# ==============================
# 分流规则：顺序与原配置保持一致
# ==============================
rules:
  - DOMAIN-SUFFIX,pingbox.top,DIRECT
  - DOMAIN-SUFFIX,msgbox.top,DIRECT

  - RULE-SET,ai,PROXY
  - RULE-SET,proxy,PROXY

  - RULE-SET,direct,DIRECT
  - RULE-SET,private,DIRECT
  - RULE-SET,lancidr,DIRECT

  - DOMAIN-SUFFIX,cdn-apple.com,DIRECT
  - DOMAIN-SUFFIX,aaplimg.com,DIRECT
  - DOMAIN-SUFFIX,mzstatic.com,DIRECT
  - DOMAIN-SUFFIX,apple.com,DIRECT
  - DOMAIN-SUFFIX,icloud.com,DIRECT
  - DOMAIN-SUFFIX,icloud-content.com,DIRECT

  - RULE-SET,cn-domain,DIRECT
  - GEOIP,CN,DIRECT,no-resolve
  - MATCH,PROXY