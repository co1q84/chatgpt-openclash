port: 7890
socks-port: 7891
allow-lan: true
bind-address: '*'
mode: rule
log-level: info
external-controller: :9090
ipv6: false
unified-delay: true
tcp-concurrent: true

# ==============================
# TUN：兼容性优先
# ==============================
tun:
  enable: true
  stack: system
  device: mihomo
  auto-route: true
  auto-detect-interface: true
  strict-route: false
  mtu: 1400
  dns-hijack:
    - any:53
    - tcp://any:53
  endpoint-independent-nat: true

# ==============================
# Sniffer：提高 fake-ip / 纯 IP 连接还原能力
# ==============================
sniffer:
  enable: true
  parse-pure-ip: true
  force-dns-mapping: true
  # 对 TLS/QUIC 不主动改写目的地，降低证书错配/原生 App 异常风险；HTTP 下方仍允许改写
  override-destination: false
  sniff:
    HTTP:
      ports:
        - 80
        - 8080-8880
      override-destination: true
    TLS:
      ports:
        - 443
        - 8443
    QUIC:
      ports:
        - 443
  skip-domain:
    - Mijia Cloud
    - '+.lan'
    - '+.local'
    - '+.msftconnecttest.com'
    - '+.msftncsi.com'
    - '+.qq.com'
    - '+.wechat.com'
    - '+.weixin.qq.com'
    - '+.douyin.com'
    - '+.snssdk.com'
    - '+.bytedance.com'
    # ChatGPT / OpenAI 原生 App：依赖 fake-ip 映射，不让嗅探错误改写目的地
    - '+.chatgpt.com'
    - '+.openai.com'
    - '+.auth.openai.com'
    - '+.oaistatic.com'
    - '+.oaiusercontent.com'
    - '+.featuregates.org'
    - '+.statsigapi.net'
    - '+.intercom.io'
    - '+.intercomcdn.com'
    - '+.ct.sendgrid.net'
    - '+.auth0.com'
    - '+.arkoselabs.com'

# ==============================
# DNS：fake-ip + 国内 DoH + 防泄漏
# ==============================
dns:
  enable: true
  listen: 0.0.0.0:1053
  ipv6: false
  prefer-h3: false
  use-hosts: true
  use-system-hosts: false
  respect-rules: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter-mode: blacklist
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - 'localhost.ptlogin2.qq.com'
    - '+.msftconnecttest.com'
    - '+.msftncsi.com'
    - '+.market.xiaomi.com'
    - '+.pool.ntp.org'
    - 'time.*.com'
    - 'time.*.gov'
    - 'time.*.edu.cn'
    - 'time1.cloud.tencent.com'
    - 'time.ustc.edu.cn'
    - 'ntp.*.com'
    - 'ntp.*.cn'
    - 'router.asus.com'
    - 'miwifi.com'
    - 'Mijia Cloud'

  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
    - 180.76.76.76

  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
    - https://120.53.53.53/dns-query

  proxy-server-nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
    - https://120.53.53.53/dns-query

  direct-nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query
    - https://120.53.53.53/dns-query
  direct-nameserver-follow-policy: false

  fallback:
    - https://dns.google/dns-query
    - https://cloudflare-dns.com/dns-query

  nameserver-policy:
    '+.arpa': 223.5.5.5
    'geosite:private,cn':
      - https://doh.pub/dns-query
      - https://dns.alidns.com/dns-query
      - https://120.53.53.53/dns-query
    'geosite:gfw,geolocation-!cn':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.pingbox.top':
      - https://doh.pub/dns-query
      - https://dns.alidns.com/dns-query
      - https://120.53.53.53/dns-query
    '+.msgbox.top':
      - https://doh.pub/dns-query
      - https://dns.alidns.com/dns-query
      - https://120.53.53.53/dns-query
    'rule-set:ai':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    'rule-set:proxy':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.google.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.googleapis.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.googleapis.cn':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.gstatic.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.youtube.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.ytimg.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.openai.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.auth.openai.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.chatgpt.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.oaistatic.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.oaiusercontent.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.featuregates.org':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.statsigapi.net':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.intercom.io':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.intercomcdn.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.ct.sendgrid.net':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.auth0.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.arkoselabs.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.anthropic.com':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query
    '+.claude.ai':
      - https://dns.google/dns-query
      - https://cloudflare-dns.com/dns-query

  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 0.0.0.0/32
      - 240.0.0.0/4
    domain:
      - '+.google.com'
      - '+.googleapis.com'
      - '+.googleapis.cn'
      - '+.gstatic.com'
      - '+.googleusercontent.com'
      - '+.ggpht.com'
      - '+.youtube.com'
      - '+.ytimg.com'
      - '+.googlevideo.com'
      - '+.facebook.com'
      - '+.twitter.com'
      - '+.x.com'
      - '+.telegram.org'
      - '+.github.com'
      - '+.githubusercontent.com'
      - '+.openai.com'
      - '+.chatgpt.com'
      - '+.oaistatic.com'
      - '+.oaiusercontent.com'
      - '+.auth.openai.com'
      - '+.featuregates.org'
      - '+.statsigapi.net'
      - '+.intercom.io'
      - '+.intercomcdn.com'
      - '+.ct.sendgrid.net'
      - '+.auth0.com'
      - '+.arkoselabs.com'
      - '+.anthropic.com'
      - '+.claude.ai'
      - '+.cloudflare.com'
      - '+.cloudflare-dns.com'
      - '+.dns.google'

proxy-providers:
  XXJichang:
    type: http
    url: https://wm1855.999631.xyz/w/wm?token=OTg0MDowODBkZjg3ZTNiMjE4NjkwZWEwMzY2YWI1NWE5Nzg1NWEzYTY0MmIz
    path: ./Proxy/XXJichang.yml
    interval: 3600
    exclude-filter: "限速|应急|测试"
    health-check:
      enable: true
      interval: 300
      url: https://cp.cloudflare.com/generate_204

proxies:

  - name: FALL_BOX
    type: ss
    dialer-proxy: BEST_JC
    server: box.pingbox.top
    port: 28388
    cipher: 2022-blake3-aes-256-gcm
    password: nLBfo/TOofzezwRzjCowsNViRSxdz5qET9MCgpv3wWE=
    udp: true

  - name: BOX_VISION
    type: vless
    server: box.pingbox.top
    port: 9443
    uuid: 7c2fea8b-4231-4f1a-bd37-6add6bbb58dc
    network: tcp
    tls: true
    udp: true
    tfo: true
    flow: xtls-rprx-vision
    packet-encoding: xudp
    servername: www.apple.com
    client-fingerprint: chrome
    reality-opts:
      public-key: OeOZkKbtmWshlupDkgDeIN9juGV_2vBGxeyuLs0gd2o
      short-id: 1223456789abcdef

proxy-groups:
  - name: BEST_JC
    type: url-test
    use:
      - XXJichang
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    lazy: false

  - name: BOX_FIRST
    type: fallback
    proxies:
      - BOX_VISION
      - FALL_BOX
    url: https://www.gstatic.com/generate_204
    interval: 300
    lazy: false

  - name: PROXY
    type: select
    proxies:
      - BOX_FIRST
      - FALL_BOX
      - BEST_JC
    url: https://www.gstatic.com/generate_204
    interval: 300
    lazy: true

rule-providers:
  private:
    type: http
    behavior: domain
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/private.txt"
    path: ./ruleset/private.yaml
    interval: 86400

  lancidr:
    type: http
    behavior: ipcidr
    url: "https://cdn.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/lancidr.txt"
    path: ./ruleset/lancidr.yaml
    interval: 86400

  ai:
    type: http
    behavior: domain
    url: "https://raw.githubusercontent.com/co1q84/chatgpt-openclash/main/ai.txt"
    path: ./ruleset/ai.yaml
    interval: 86400
    
  proxy:
    type: http
    behavior: classical
    url: "https://raw.githubusercontent.com/co1q84/chatgpt-openclash/main/proxy.txt"
    path: ./ruleset/proxy.yaml
    interval: 86400

  direct:
    type: http
    behavior: classical
    url: "https://raw.githubusercontent.com/co1q84/chatgpt-openclash/main/direct.txt"
    path: ./ruleset/direct_classical.yaml
    interval: 86400

rules:
  # AI / LLM：必须靠前，避免被国内规则误判直连
  - RULE-SET,ai,PROXY
  - RULE-SET,proxy,PROXY

  # 电商、银行/支付、国内视频：直连
  - RULE-SET,direct,DIRECT

  # 内网、私有地址、本机服务：直连
  - RULE-SET,private,DIRECT
  - RULE-SET,lancidr,DIRECT
  - GEOIP,LAN,DIRECT,no-resolve

  # 你自己的内网设备直连规则；不用就删掉这一行
  - AND,((SRC-IP-CIDR,192.168.100.186/32),(DST-PORT,1000-63000)),DIRECT

  # 你自己的域名；不用就删掉
  - DOMAIN-SUFFIX,pingbox.top,DIRECT
  - DOMAIN-SUFFIX,msgbox.top,DIRECT

  # Codex Apple CDN direct: keep Apple system/CDN traffic on local ISP/CDN
  - DOMAIN-SUFFIX,cdn-apple.com,DIRECT
  - DOMAIN-SUFFIX,aaplimg.com,DIRECT
  - DOMAIN-SUFFIX,mzstatic.com,DIRECT
  - DOMAIN-SUFFIX,apple.com,DIRECT
  - DOMAIN-SUFFIX,icloud.com,DIRECT
  - DOMAIN-SUFFIX,icloud-content.com,DIRECT

  # 国内兜底直连
  - GEOSITE,cn,DIRECT
  - GEOIP,CN,DIRECT,no-resolve

  # 其他全部走代理
  - MATCH,PROXY
